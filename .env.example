# Copy to .env.local for local development.
# On Vercel these go in Project → Settings → Environment Variables.

# Where signups are stored: "console" (default, logs only — persists nothing)
# or "sheets". An unknown value makes the app fail loudly on submit.
SIGNUP_STORAGE=console

# --- Only needed when SIGNUP_STORAGE=sheets -----------------------------------
# See lib/storage/sheets.ts for the full setup steps. The service account's
# email must be given Editor access to the spreadsheet itself.

# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the JSON key's private_key value, keeping the \n escapes, in quotes.
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional, defaults to Signups!A:F
# GOOGLE_SHEETS_RANGE=Signups!A:F
